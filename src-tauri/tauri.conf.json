{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fleet",
  "version": "0.1.0",
  "identifier": "dev.fleet.app",
  "build": {
    "beforeDevCommand": "npm run build:hook && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:hook && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fleet",
        "width": 1480,
        "height": 920,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0D1117",
        "theme": "Dark",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/fleet-hook",
      "binaries/fleet-remote-mcp"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "resources": {
      "../node_modules/typescript-language-server/lib/cli.mjs": "lsp/tsls/lib/cli.mjs",
      "../node_modules/typescript-language-server/package.json": "lsp/tsls/package.json",
      "../node_modules/typescript/lib/": "lsp/typescript/lib/",
      "../node_modules/typescript/package.json": "lsp/typescript/package.json"
    },
    "category": "DeveloperTool",
    "shortDescription": "A terminal IDE for many Claude Code sessions"
  }
}
