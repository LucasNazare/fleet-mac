{
  "name": "fleet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:hook": "cargo build --release --manifest-path fleet-hook/Cargo.toml && cargo build --release --manifest-path fleet-remote-mcp/Cargo.toml && mkdir -p src-tauri/binaries && T=$(rustc -vV | sed -n 's/host: //p') && cp fleet-hook/target/release/fleet-hook src-tauri/binaries/fleet-hook-$T && cp fleet-remote-mcp/target/release/fleet-remote-mcp src-tauri/binaries/fleet-remote-mcp-$T",
    "test:e2e": "playwright test",
    "test:rust": "cd src-tauri && cargo test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.4",
    "monaco-editor": "^0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript-language-server": "^6.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
